<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PortJeep" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/color_brand_primary</item>
        <item name="colorSecondary">@color/color_brand_secondary</item>
        <item name="colorAccent">@color/color_brand_accent</item>

        <!-- Surface and Background -->
        <item name="android:colorBackground">@color/color_background_primary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>

        <!-- Text and Icons -->
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>

        <!-- Custom attributes -->
        <item name="logoTint">@null</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>

        <!-- Status bar and navigation bar colors -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PortJeep" parent="Base.Theme.PortJeep" />
</resources>