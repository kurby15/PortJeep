<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8EDF7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2E58B8"
            android:paddingStart="@dimen/spacing_standard"
            android:paddingTop="@dimen/spacing_section"
            android:paddingEnd="@dimen/spacing_standard"
            android:paddingBottom="@dimen/spacing_large">

            <LinearLayout
                android:id="@+id/ll_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning,"
                    android:textColor="#B3C6F7"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_driver_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ricardo"
                    android:textColor="@android:color/white"
                    android:textSize="24dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Role Badge -->
            <TextView
                android:id="@+id/tv_role_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_greeting"
                android:layout_marginTop="@dimen/spacing_compact"
                android:background="@drawable/bg_badge_role"
                android:paddingStart="@dimen/spacing_compact"
                android:paddingTop="@dimen/spacing_extra_small"
                android:paddingEnd="@dimen/spacing_compact"
                android:paddingBottom="@dimen/spacing_extra_small"
                android:text="DRIVER"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Main Body Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-16dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/spacing_section">

            <!-- Today's Assignment Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/card_corner_radius_standard"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_standard">

                    <!-- Title & Date Row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TODAY'S ASSIGNMENT"
                            android:textColor="#90A4AE"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_today_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="August 9, 2026"
                            android:textColor="#3D6FD4"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Vehicle Info Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_compact"
                        android:background="@drawable/bg_jeep_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_compact">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_icon"
                            android:padding="@dimen/spacing_small"
                            android:src="@drawable/car"
                            app:tint="#3D6FD4" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_compact"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="E-JEEP"
                                android:textColor="#90A4AE"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_unit_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Unit 3"
                                android:textColor="#263238"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_plate_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EJP 1234"
                                android:textColor="#78909C"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_jeep_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_active"
                            android:paddingStart="@dimen/spacing_small"
                            android:paddingTop="@dimen/spacing_extra_small"
                            android:paddingEnd="@dimen/spacing_small"
                            android:paddingBottom="@dimen/spacing_extra_small"
                            android:text="●  Active"
                            android:textColor="#2E7D32"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Crew Row (Driver & PAO) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_compact"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:layout_weight="1"
                            android:background="#F8FAFC"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_compact">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Driver"
                                android:textColor="#90A4AE"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_driver_fullname"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_extra_small"
                                android:text="Ricardo Dela Cruz"
                                android:textColor="#263238"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:layout_weight="1"
                            android:background="#F8FAFC"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_compact">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PAO"
                                android:textColor="#90A4AE"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_pao_fullname"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_extra_small"
                                android:text="Maria Buenaventura"
                                android:textColor="#263238"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- GPS Status & Assigned Badge -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_compact">

                        <TextView
                            android:id="@+id/tv_assignment_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_status_assigned"
                            android:paddingStart="@dimen/spacing_compact"
                            android:paddingTop="@dimen/spacing_extra_small"
                            android:paddingEnd="@dimen/spacing_compact"
                            android:paddingBottom="@dimen/spacing_extra_small"
                            android:text="●  Assigned"
                            android:textColor="#3D6FD4"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Access Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_section"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="QUICK ACCESS"
                android:textColor="#90A4AE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- My Schedule Quick Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_my_schedule"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius_standard"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding_standard">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_quick_schedule"
                            android:padding="@dimen/spacing_small"
                            android:src="@drawable/calendar"
                            app:tint="#3D6FD4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_compact"
                            android:text="My Schedule"
                            android:textColor="#263238"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Salary Quick Card (Replaced Live GPS) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_salary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius_standard"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding_standard">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_quick_salary"
                            android:padding="@dimen/spacing_small"
                            android:src="@drawable/wallet"
                            app:tint="#2E7D32" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_compact"
                            android:text="Salary"
                            android:textColor="#263238"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Upcoming Schedules Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_section"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="UPCOMING SCHEDULES"
                android:textColor="#90A4AE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/card_corner_radius_standard"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/container_upcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="?android:attr/listDivider"
                    android:orientation="vertical"
                    android:showDividers="middle" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>