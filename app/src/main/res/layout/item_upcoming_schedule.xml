<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <!-- Calendar Icon Unit -->
    <ImageView
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_circle_icon"
        android:backgroundTint="@color/color_background_secondary"
        android:contentDescription="Schedule date"
        android:padding="12dp"
        android:src="@drawable/calendar"
        app:tint="@color/color_brand_primary" />

    <!-- Date Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_schedule_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            tools:text="Friday" />

        <TextView
            android:id="@+id/tv_schedule_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"
            tools:text="August 14, 2026" />

    </LinearLayout>

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tv_schedule_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/bg_status_assigned"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:textColor="@color/color_status_assigned_text"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="●  Assigned" />

    <!-- Chevron Indicator -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="View details"
        android:src="@drawable/chevron"
        app:tint="@color/color_text_muted" />

</LinearLayout>