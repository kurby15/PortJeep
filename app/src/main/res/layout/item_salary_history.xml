<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mcv_salary_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/color_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Row: Date, Badge, and Chevron -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_history_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-black"
                android:text="Saturday, Aug 8"
                android:textColor="@color/color_brand_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_recorded_badge"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tv_status_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ "
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_status_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="RECORDED"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_rest_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_rest"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="REST"
                    android:textColor="@color/color_brand_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_chevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Expand"
                    android:src="@drawable/chevron"
                    app:tint="#D1D1D1" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Detail Section (hidden by default) -->
        <LinearLayout
            android:id="@+id/ll_detail_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/color_divider" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- Labels -->
                <TextView
                    android:id="@+id/tv_label_gross"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="GROSS"
                    android:textColor="#B0BEC5"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tv_history_val_gross"
                    app:layout_constraintStart_toStartOf="@+id/tv_history_val_gross"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_label_boundary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="BOUNDARY + FUEL"
                    android:textColor="#B0BEC5"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tv_history_val_boundary_fuel"
                    app:layout_constraintStart_toStartOf="@+id/tv_history_val_boundary_fuel"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_label_net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="NET"
                    android:textColor="#B0BEC5"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tv_history_val_net"
                    app:layout_constraintStart_toStartOf="@+id/tv_history_val_net"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Values and Operators -->
                <TextView
                    android:id="@+id/tv_history_val_gross"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="₱ 1,680"
                    android:textColor="@color/color_brand_primary"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_op_minus"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_gross" />

                <TextView
                    android:id="@+id/tv_op_minus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#E57373"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tv_history_val_gross"
                    app:layout_constraintEnd_toStartOf="@+id/tv_history_val_boundary_fuel"
                    app:layout_constraintStart_toEndOf="@id/tv_history_val_gross"
                    app:layout_constraintTop_toTopOf="@id/tv_history_val_gross" />

                <TextView
                    android:id="@+id/tv_history_val_boundary_fuel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="₱ 780"
                    android:textColor="@color/color_brand_primary"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_op_equal"
                    app:layout_constraintStart_toEndOf="@id/tv_op_minus"
                    app:layout_constraintTop_toTopOf="@id/tv_history_val_gross" />

                <TextView
                    android:id="@+id/tv_op_equal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="="
                    android:textColor="#E57373"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tv_history_val_gross"
                    app:layout_constraintEnd_toStartOf="@+id/tv_history_val_net"
                    app:layout_constraintStart_toEndOf="@id/tv_history_val_boundary_fuel"
                    app:layout_constraintTop_toTopOf="@id/tv_history_val_gross" />

                <TextView
                    android:id="@+id/tv_history_val_net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="₱ 900"
                    android:textColor="@color/color_brand_primary"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_op_equal"
                    app:layout_constraintTop_toTopOf="@id/tv_history_val_gross" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
