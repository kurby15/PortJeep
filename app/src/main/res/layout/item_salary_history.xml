<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mcv_salary_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/card_corner_radius_large"
    app:cardElevation="4dp"
    app:strokeColor="@color/color_divider"
    app:strokeWidth="1dp"
    android:outlineAmbientShadowColor="@color/color_card_shadow_ambient"
    android:outlineSpotShadowColor="@color/color_card_shadow_spot">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_history_item_gradient"
        android:orientation="vertical"
        android:padding="22dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ll_header_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_badges_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_history_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constrainedWidth="true"
                    tools:text="Saturday, Aug 8" />

                <TextView
                    android:id="@+id/tv_trip_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/color_brand_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="4 trips recorded" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_badges_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/ll_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_status_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_recorded"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="RECORDED"
                        android:textColor="@color/color_status_badge_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_rest_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_rest"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="REST DAY"
                    android:textColor="@color/color_status_badge_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_chevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Expand"
                    android:src="@drawable/chevron"
                    app:tint="@color/color_text_muted" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/ll_detail_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider" />

            <LinearLayout
                android:id="@+id/ll_partial_reports_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tv_label_history_gross"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="start"
                    android:text="TOTAL GROSS"
                    android:textColor="@color/color_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tv_summary_minus"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_history_val_gross"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:gravity="start"
                    android:maxLines="1"
                    android:text="₱ 0.00"
                    android:textColor="@color/color_brand_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tv_label_history_gross"
                    app:layout_constraintStart_toStartOf="@+id/tv_label_history_gross"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_history_gross" />

                <TextView
                    android:id="@+id/tv_summary_minus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:text="−"
                    android:textColor="@android:color/transparent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_history_val_gross"
                    app:layout_constraintEnd_toStartOf="@+id/tv_label_history_remittance"
                    app:layout_constraintStart_toEndOf="@+id/tv_label_history_gross"
                    app:layout_constraintTop_toTopOf="@+id/tv_history_val_gross" />

                <TextView
                    android:id="@+id/tv_label_history_remittance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="EXPENSES+BONUS"
                    android:textColor="@color/color_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tv_summary_equal"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tv_summary_minus"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_history_val_remittance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="₱ 0.00"
                    android:textColor="@color/color_brand_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tv_label_history_remittance"
                    app:layout_constraintStart_toStartOf="@+id/tv_label_history_remittance"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_history_remittance" />

                <TextView
                    android:id="@+id/tv_summary_equal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:text="="
                    android:textColor="@android:color/transparent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_history_val_remittance"
                    app:layout_constraintEnd_toStartOf="@+id/tv_label_history_net"
                    app:layout_constraintStart_toEndOf="@+id/tv_label_history_remittance"
                    app:layout_constraintTop_toTopOf="@+id/tv_history_val_remittance" />

                <TextView
                    android:id="@+id/tv_label_history_net"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="end"
                    android:text="TOTAL NET"
                    android:textColor="@color/color_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tv_summary_equal"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_history_val_net"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="₱ 0.00"
                    android:textColor="@color/color_brand_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tv_label_history_net"
                    app:layout_constraintStart_toStartOf="@+id/tv_label_history_net"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_history_net" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>