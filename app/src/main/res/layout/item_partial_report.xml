<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_stats_item"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_partial_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="#5C6BC0"
        android:textSize="11sp"
        tools:text="#1 • Aug 8, 6:14 AM" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tv_label_partial_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="start"
            android:text="PARTIAL AMT"
            android:textColor="#B0BEC5"
            android:textSize="9sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_partial_minus"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_label_partial_expenses"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="EXPENSES"
            android:textColor="#B0BEC5"
            android:textSize="9sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_partial_equal"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/tv_partial_minus"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_label_partial_net"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="end"
            android:text="NET INCOME"
            android:textColor="#B0BEC5"
            android:textSize="9sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/tv_partial_equal"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_val_partial_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-black"
            android:gravity="start"
            android:text="₱ 0"
            android:textColor="@color/color_brand_primary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_label_partial_amount"
            app:layout_constraintStart_toStartOf="@+id/tv_label_partial_amount"
            app:layout_constraintTop_toBottomOf="@id/tv_label_partial_amount"
            app:layout_constrainedWidth="true" />

        <TextView
            android:id="@+id/tv_partial_minus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="−"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_val_partial_amount"
            app:layout_constraintEnd_toStartOf="@+id/tv_label_partial_expenses"
            app:layout_constraintStart_toEndOf="@+id/tv_label_partial_amount"
            app:layout_constraintTop_toTopOf="@+id/tv_val_partial_amount" />

        <TextView
            android:id="@+id/tv_val_partial_expenses"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="₱ 0"
            android:textColor="@color/color_brand_primary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_label_partial_expenses"
            app:layout_constraintStart_toStartOf="@+id/tv_label_partial_expenses"
            app:layout_constraintTop_toBottomOf="@id/tv_label_partial_expenses"
            app:layout_constrainedWidth="true" />

        <TextView
            android:id="@+id/tv_partial_equal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="="
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_val_partial_expenses"
            app:layout_constraintEnd_toStartOf="@+id/tv_label_partial_net"
            app:layout_constraintStart_toEndOf="@+id/tv_label_partial_expenses"
            app:layout_constraintTop_toTopOf="@+id/tv_val_partial_expenses" />

        <TextView
            android:id="@+id/tv_val_partial_net"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-black"
            android:gravity="end"
            android:text="₱ 0"
            android:textColor="@color/color_brand_primary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_label_partial_net"
            app:layout_constraintStart_toStartOf="@+id/tv_label_partial_net"
            app:layout_constraintTop_toBottomOf="@id/tv_label_partial_net"
            app:layout_constrainedWidth="true" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>