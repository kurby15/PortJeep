<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    tools:context="com.example.portjeep.auth.LogInActivity">

    <!-- 1. Logo Section (Top) -->
    <LinearLayout
        android:id="@+id/layout_top_logo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:gravity="center">

        <ImageView
            android:id="@+id/img_login_logo"
            android:layout_width="280dp"
            android:layout_height="220dp"
            android:layout_marginTop="39dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/desc_login_logo"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon1"
            app:tint="?attr/logoTint" />
    </LinearLayout>

    <!-- 2. Organic Wave Divider (The real separator) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/ic_wave_divider" />

    <!-- 3. Welcome Container (Bottom) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/login_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-1dp"
        android:layout_weight="2.2"
        android:background="@drawable/bg_bottom_sheet_card"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/login_form_padding_horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tv_login_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-7dp"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:text="@string/login_welcome_back"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_size_xlarge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_login_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:gravity="center"
                android:text="@string/login_subtitle"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_size_body" />

            <!-- Email Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="@string/login_email_hint"
                app:boxCornerRadiusBottomEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusTopStart="24dp"
                app:boxStrokeColor="@color/color_brand_primary"
                app:errorEnabled="true"
                app:errorIconDrawable="@null">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:hint="@string/login_password_hint"
                app:boxCornerRadiusBottomEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusTopStart="24dp"
                app:boxStrokeColor="@color/color_brand_primary"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:errorIconDrawable="@null">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:padding="8dp"
                android:text="@string/login_forgot_password"
                android:textColor="@color/color_brand_accent"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_error_banner"
                android:drawableStart="@drawable/warning"
                android:drawablePadding="10dp"
                android:padding="12dp"
                android:textColor="@color/color_error_text"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Verification Error"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_gradient"
                android:elevation="4dp"
                android:text="@string/login_btn_sign_in"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="27dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBiometric"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/login_biometric_text"
                android:textAllCaps="false"
                android:textColor="@color/color_brand_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:visibility="gone"
                app:icon="@drawable/fingerprint"
                app:iconTint="@color/color_brand_primary"
                tools:visibility="visible" />

            <!-- reCAPTCHA Notice -->
            <TextView
                android:id="@+id/tv_recaptcha_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.5"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/login_recaptcha_notice"
                android:textColor="@color/color_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvCopyright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.5"
                android:gravity="center"
                android:text="@string/login_copyright"
                android:textColor="@color/color_text_muted"
                android:textSize="@dimen/text_size_micro" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
