<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E58B8"
    tools:context=".LogInActivity">

    <!-- Top Header Section (Height trimmed to 260dp to accommodate larger inputs) -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_compact">

        <ImageView
            android:layout_width="360dp"
            android:layout_height="300dp"
            android:contentDescription="PortJeep Logo"
            android:src="@drawable/icon1"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- White Form Card -->
    <ScrollView
        android:id="@+id/bottomSheetCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topHeader"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_sheet_card"
        android:elevation="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_section"
            android:paddingEnd="@dimen/spacing_section"
            android:paddingBottom="@dimen/spacing_standard">

            <!-- Drag Handle -->
            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_compact"
                android:layout_marginBottom="@dimen/spacing_compact"
                android:background="#E5E7EB"
                android:alpha="0.8" />

            <!-- Title Section (Enlarged text size) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Sign In"
                android:textColor="#1E3A8A"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_extra_small"
                android:layout_marginBottom="@dimen/spacing_standard"
                android:text="Sign in to access your account"
                android:textColor="#6B7280"
                android:textSize="15sp" />

            <!-- Email Label & Input (Enlarged 58dp height & 16sp font) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#1E3A8A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_compact"
                android:background="@drawable/bg_pill_input"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="20dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="16sp" />

            <!-- Password Label & Input (Enlarged 58dp height & 16sp font) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#1E3A8A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_extra_small"
                android:background="@drawable/bg_pill_input"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:paddingHorizontal="20dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="16sp" />

            <!-- Forgot Password Link -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="@dimen/spacing_compact"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:text="Forgot Password?"
                android:textColor="#2E58B8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_compact"
                android:background="@drawable/bg_error_banner"
                android:drawableStart="@drawable/warning"
                android:drawablePadding="@dimen/spacing_small"
                android:padding="@dimen/spacing_compact"
                android:textColor="#C62828"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Please enter both email and password"
                tools:visibility="visible" />

            <!-- Sign In Button (Enlarged 60dp height & 17sp font) -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="#2E58B8"
                android:text="Sign in"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:elevation="4dp"
                app:cornerRadius="30dp" />

            <!-- Copyright Watermark -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_compact"
                android:gravity="center"
                android:text="© 2026 Sapang Palay Minuyan MultiPurpose Cooperative"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>