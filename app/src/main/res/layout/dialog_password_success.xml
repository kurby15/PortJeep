<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_standard"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/card_corner_radius_xlarge"
    app:cardElevation="8dp"
    app:layout_constraintWidth_max="@dimen/dialog_max_width"
    app:strokeColor="@color/color_divider"
    app:strokeWidth="1dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_success_icon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/check" />

            <TextView
                android:id="@+id/tv_success_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_standard"
                android:text="Success"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold"
                android:gravity="center"
                app:layout_constrainedWidth="true" />

            <TextView
                android:id="@+id/tv_success_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:text="Your changes have been saved successfully."
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_size_body_large"
                app:layout_constrainedWidth="true" />

            <TextView
                android:id="@+id/tv_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_section"
                android:text="Closing in 3..."
                android:textColor="@color/color_brand_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>