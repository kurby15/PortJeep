<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_profile"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent">

            <!-- Header Section -->
            <LinearLayout
                android:id="@+id/ll_profile_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin_large"
                android:paddingTop="32dp"
                android:paddingBottom="48dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Profile"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:alpha="0.8"
                    android:text="View and manage your account details"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Profile Summary Card Overlap -->
            <FrameLayout
                android:id="@+id/fl_summary_card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-28dp"
                android:paddingHorizontal="20dp"
                app:layout_constraintTop_toBottomOf="@id/ll_profile_header">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_profile_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:shimmer_auto_start="true"
                    app:shimmer_base_alpha="0.5"
                    app:shimmer_duration="1000"
                    app:shimmer_highlight_alpha="0.9">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/card_corner_radius_xlarge"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="22dp">
                            <View android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_skeleton" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_weight="1" android:orientation="vertical">
                                <View android:layout_width="150dp" android:layout_height="18dp" android:background="@drawable/bg_skeleton" />
                                <View android:layout_width="100dp" android:layout_height="12dp" android:layout_marginTop="8dp" android:background="@drawable/bg_skeleton" />
                                <View android:layout_width="80dp" android:layout_height="22dp" android:layout_marginTop="12dp" android:background="@drawable/bg_skeleton" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_profile_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="@dimen/card_corner_radius_xlarge"
                    app:cardElevation="10dp"
                    app:strokeColor="@color/color_divider"
                    app:strokeWidth="1dp"
                    android:outlineAmbientShadowColor="@color/color_card_shadow_ambient"
                    android:outlineSpotShadowColor="@color/color_card_shadow_spot"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="22dp">

                        <TextView
                            android:id="@+id/tv_avatar_initials"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_circle_icon"
                            android:backgroundTint="@color/color_quick_access_fill"
                            android:gravity="center"
                            android:text="U"
                            android:textColor="@color/color_brand_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_profile_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loading..."
                                android:textColor="@color/color_text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_employee_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="EMP-0000"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_status_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_status_active_gradient"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="●  Active"
                                android:textColor="@color/color_status_active_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Content Area Container -->
            <FrameLayout
                android:id="@+id/fl_profile_content_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fl_summary_card_container" />

            <View
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Fragment Container for No Internet -->
    <FrameLayout
        android:id="@+id/no_internet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
