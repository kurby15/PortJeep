<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_profile"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_background_primary"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            tools:context="com.example.portjeep.profile.ProfileFragment">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical">

                <!-- ========================================================= -->
                <!-- MODERN HEADER                                             -->
                <!-- ========================================================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/color_brand_primary"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="30dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="42dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="My Profile"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <!-- Subtitle -->
                    <TextView
                        android:id="@+id/tv_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:alpha="0.8"
                        android:text="View and manage your account details"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- ========================================================= -->
                <!-- MAIN CONTENT CONTAINER                                    -->
                <!-- ========================================================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-22dp"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="36dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/shimmer_profile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:shimmer_auto_start="true"
                            app:shimmer_base_alpha="0.5"
                            app:shimmer_duration="1000"
                            app:shimmer_highlight_alpha="0.9">
                            <include layout="@layout/item_skeleton_profile" />
                        </com.facebook.shimmer.ShimmerFrameLayout>

                        <LinearLayout
                            android:id="@+id/ll_profile_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <!-- Profile Summary Header Card -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/color_surface"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="3dp"
                                app:strokeColor="@color/color_divider"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:padding="20dp">

                                    <TextView
                                        android:id="@+id/tv_avatar_initials"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:background="@drawable/bg_circle_avatar"
                                        android:backgroundTint="@color/color_background_secondary"
                                        android:gravity="center"
                                        android:text="RD"
                                        android:textColor="@color/color_brand_primary"
                                        android:textSize="20sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_profile_name"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Ricardo Dela Cruz"
                                            android:textColor="@color/color_text_primary"
                                            android:textSize="18sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tv_employee_number"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="EMP-2024-0042"
                                            android:textColor="@color/color_text_secondary"
                                            android:textSize="11sp" />

                                        <TextView
                                            android:id="@+id/tv_status_badge"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:background="@drawable/bg_status_active"
                                            android:paddingStart="10dp"
                                            android:paddingTop="5dp"
                                            android:paddingEnd="10dp"
                                            android:paddingBottom="5dp"
                                            android:text="●  Active"
                                            android:textColor="#2E7D32"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- SECTION 1: PERSONAL INFORMATION -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="26dp"
                                android:layout_marginBottom="8dp"
                                android:letterSpacing="0.05"
                                android:text="PERSONAL INFORMATION"
                                android:textColor="@color/color_brand_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/color_surface"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="2dp"
                                app:strokeColor="@color/color_divider"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:divider="?android:attr/listDivider"
                                    android:orientation="vertical"
                                    android:showDividers="middle">

                                    <!-- Position -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:padding="16dp">

                                        <ImageView
                                            android:layout_width="38dp"
                                            android:layout_height="38dp"
                                            android:background="@drawable/bg_icon_blue_light"
                                            android:backgroundTint="@color/color_background_secondary"
                                            android:padding="10dp"
                                            android:src="@drawable/work"
                                            app:tint="@color/color_brand_primary" />

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="13dp"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="POSITION"
                                                android:textColor="@color/color_text_muted"
                                                android:textSize="10sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/tv_position"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="2dp"
                                                android:text="Driver"
                                                android:textColor="@color/color_text_primary"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <!-- Date Hired -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:padding="16dp">

                                        <ImageView
                                            android:layout_width="38dp"
                                            android:layout_height="38dp"
                                            android:background="@drawable/bg_icon_blue_light"
                                            android:backgroundTint="@color/color_background_secondary"
                                            android:padding="10dp"
                                            android:src="@drawable/calendar"
                                            app:tint="@color/color_brand_primary" />

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="13dp"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="DATE HIRED"
                                                android:textColor="@color/color_text_muted"
                                                android:textSize="10sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/tv_date_hired"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="2dp"
                                                android:text="June 1, 2021"
                                                android:textColor="@color/color_text_primary"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <!-- Civil Status -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:padding="16dp">

                                        <ImageView
                                            android:layout_width="38dp"
                                            android:layout_height="38dp"
                                            android:background="@drawable/bg_icon_blue_light"
                                            android:backgroundTint="@color/color_background_secondary"
                                            android:padding="10dp"
                                            android:src="@drawable/civil"
                                            app:tint="@color/color_brand_primary" />

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="13dp"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="CIVIL STATUS"
                                                android:textColor="@color/color_text_muted"
                                                android:textSize="10sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/tv_civil_status"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="2dp"
                                                android:text="Married"
                                                android:textColor="@color/color_text_primary"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <!-- Sex -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:padding="16dp">

                                        <ImageView
                                            android:layout_width="38dp"
                                            android:layout_height="38dp"
                                            android:background="@drawable/bg_icon_blue_light"
                                            android:backgroundTint="@color/color_background_secondary"
                                            android:padding="10dp"
                                            android:src="@drawable/sex"
                                            app:tint="@color/color_brand_primary" />

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="13dp"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="SEX"
                                                android:textColor="@color/color_text_muted"
                                                android:textSize="10sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/tv_sex"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="2dp"
                                                android:text="Male"
                                                android:textColor="@color/color_text_primary"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>
                                    </LinearLayout>

                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- SECTION 2: CONTACT INFORMATION -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="26dp"
                                android:layout_marginBottom="8dp"
                                android:letterSpacing="0.05"
                                android:text="CONTACT INFORMATION"
                                android:textColor="@color/color_brand_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/color_surface"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="2dp"
                                app:strokeColor="@color/color_divider"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:divider="?android:attr/listDivider"
                                    android:orientation="vertical"
                                    android:showDividers="middle">

                                    <!-- Email -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:padding="16dp">

                                        <ImageView
                                            android:layout_width="38dp"
                                            android:layout_height="38dp"
                                            android:background="@drawable/bg_icon_blue_light"
                                            android:backgroundTint="@color/color_background_secondary"
                                            android:padding="10dp"
                                            android:src="@drawable/mail"
                                            app:tint="@color/color_brand_primary" />

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="13dp"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="EMAIL"
                                                android:textColor="@color/color_text_muted"
                                                android:textSize="10sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/tv_email"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="2dp"
                                                android:text="r.delacruz@portjeep.ph"
                                                android:textColor="@color/color_text_primary"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <!-- Contact No. -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:padding="16dp">

                                        <ImageView
                                            android:layout_width="38dp"
                                            android:layout_height="38dp"
                                            android:background="@drawable/bg_icon_blue_light"
                                            android:backgroundTint="@color/color_background_secondary"
                                            android:padding="10dp"
                                            android:src="@drawable/phone"
                                            app:tint="@color/color_brand_primary" />

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="13dp"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="CONTACT NO."
                                                android:textColor="@color/color_text_muted"
                                                android:textSize="10sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/tv_phone"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="2dp"
                                                android:text="09171234567"
                                                android:textColor="@color/color_text_primary"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <!-- Address -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:padding="16dp">

                                        <ImageView
                                            android:layout_width="38dp"
                                            android:layout_height="38dp"
                                            android:background="@drawable/bg_icon_blue_light"
                                            android:backgroundTint="@color/color_background_secondary"
                                            android:padding="10dp"
                                            android:src="@drawable/location"
                                            app:tint="@color/color_brand_primary" />

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="13dp"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="ADDRESS"
                                                android:textColor="@color/color_text_muted"
                                                android:textSize="10sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/tv_address"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="2dp"
                                                android:text="Brgy. Balintawak, Caloocan City"
                                                android:textColor="@color/color_text_primary"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>
                                    </LinearLayout>

                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- SECTION 3: ACTION BUTTONS -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_change_password"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="26dp"
                                android:text="CHANGE PASSWORD"
                                android:textColor="@color/color_brand_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp"
                                app:strokeColor="@color/color_brand_primary"
                                app:strokeWidth="1.5dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_sign_out"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="10dp"
                                android:backgroundTint="@color/color_background_secondary"
                                android:text="SIGN OUT"
                                android:textColor="@color/color_brand_accent"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/logout"
                                app:iconGravity="textStart"
                                app:iconTint="@color/color_brand_accent" />

                            <!-- Bottom spacing to prevent content from being hidden behind the navigation bar -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="140dp" />

                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Fragment Container for No Internet -->
    <FrameLayout
        android:id="@+id/no_internet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
