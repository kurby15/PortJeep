<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Day Name (Aligned to Left 60% column) -->
    <TextView
        android:id="@+id/tv_unassigned_day_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.6"
        android:textColor="@color/color_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Monday" />

    <!-- Unassigned Status Column (Remaining 40%) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.4"
        android:gravity="start|center_vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/tv_unassigned_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_unassigned"
            android:letterSpacing="0.05"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textAllCaps="true"
            android:textColor="@color/color_error_text"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="●  UNASSIGNED" />

    </LinearLayout>

</LinearLayout>